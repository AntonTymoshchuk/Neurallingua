<Page x:Class="Neurallingua.TaskType1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Neurallingua"
      mc:Ignorable="d"
      Title="TaskType1Page" Width="405" Height="484">

    <Grid>
        <TextBlock x:Name="phraseTextBlock" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="100" Width="386" FontSize="16" TextAlignment="Center"/>
        <Button x:Name="variant1Button" HorizontalAlignment="Left" Margin="10,115,0,0" VerticalAlignment="Top" Height="150" Width="190" Click="variantButton_Click">
            <TextBlock x:Name="variant1TextBlock" TextWrapping="Wrap" Text="TextBlock" FontSize="16" TextAlignment="Center"/>
        </Button>
        <Button x:Name="variant2Button" HorizontalAlignment="Left" Margin="205,115,0,0" VerticalAlignment="Top" Width="190" Height="150" Click="variantButton_Click">
            <TextBlock x:Name="variant2TextBlock" TextWrapping="Wrap" Text="TextBlock" FontSize="16"/>
        </Button>
        <Button x:Name="variant3Button" HorizontalAlignment="Left" Margin="10,270,0,0" VerticalAlignment="Top" Height="148" Width="190" Click="variantButton_Click">
            <TextBlock x:Name="variant3TextBlock" TextWrapping="Wrap" Text="TextBlock" FontSize="16"/>
        </Button>
        <Button x:Name="variant4Button" HorizontalAlignment="Left" Margin="205,270,0,0" VerticalAlignment="Top" Height="148" Width="190" Click="variantButton_Click">
            <TextBlock x:Name="variant4TextBlock" TextWrapping="Wrap" Text="TextBlock" FontSize="16"/>
        </Button>
        <Button x:Name="continueButton" Content="Продолжить" HorizontalAlignment="Center" Margin="0,424,0,0" VerticalAlignment="Top" Width="386" Height="50" FontSize="16" Click="continueButton_Click"/>
    </Grid>
</Page>
