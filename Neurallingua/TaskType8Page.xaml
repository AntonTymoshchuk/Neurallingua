<Page x:Class="Neurallingua.TaskType8Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Neurallingua"
      mc:Ignorable="d"
      Title="TaskType8Page" Height="484" Width="405">

    <Grid>
        <Button x:Name="listenButton" Content="🔊" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Height="100" Width="386" FontSize="16" Click="listenButton_Click"/>
        <TextBox x:Name="translationTextBox" HorizontalAlignment="Center" Margin="0,115,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="386" Height="100" FontSize="16" TextAlignment="Center"/>
        <TextBlock x:Name="answerTextBlock" HorizontalAlignment="Center" Margin="0,220,0,0" TextWrapping="Wrap" Text="Написать на русском" VerticalAlignment="Top" Height="100" Width="386" FontSize="16" TextAlignment="Center"/>
        <Button x:Name="continueButton" Content="Проверить" HorizontalAlignment="Center" Margin="0,424,0,0" VerticalAlignment="Top" Width="386" Height="50" FontSize="16" Click="continueButton_Click"/>

    </Grid>
</Page>
