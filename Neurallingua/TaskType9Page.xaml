<Page x:Class="Neurallingua.TaskType9Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Neurallingua"
      mc:Ignorable="d"
      Title="TaskType9Page" Height="700" Width="525">

    <Grid>
        <TextBlock x:Name="phraseTextBlock" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="150" Width="505" FontSize="20" TextAlignment="Center"/>
        <Button x:Name="continueButton" Content="Продолжить" HorizontalAlignment="Center" Margin="0,590,0,0" VerticalAlignment="Top" Width="505" Height="100" FontSize="20" Click="continueButton_Click"/>
        <Button x:Name="speakButton" Content="💬" HorizontalAlignment="Center" Margin="0,165,0,0" VerticalAlignment="Top" Height="150" Width="505" FontSize="20" Click="speakButton_Click"/>

    </Grid>
</Page>
