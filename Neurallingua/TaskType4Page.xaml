<Page x:Class="Neurallingua.TaskType4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Neurallingua"
      mc:Ignorable="d"
      Title="TaskType4Page" Height="700" Width="525">

    <Grid>
        <TextBlock x:Name="phraseTextBlock" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="150" Width="505" FontSize="20" TextAlignment="Center"/>
        <Button x:Name="variant1Button" HorizontalAlignment="Left" Margin="10,165,0,0" VerticalAlignment="Top" Height="200" Width="250" Content="🔊 1" FontSize="20" Click="variantButton_Click"/>
        <Button x:Name="variant2Button" HorizontalAlignment="Left" Margin="265,165,0,0" VerticalAlignment="Top" Width="250" Height="200" Content="🔊 2" FontSize="20" Click="variantButton_Click"/>
        <Button x:Name="variant3Button" HorizontalAlignment="Left" Margin="10,370,0,0" VerticalAlignment="Top" Height="200" Width="250" Content="🔊 3" FontSize="20" Click="variantButton_Click"/>
        <Button x:Name="variant4Button" HorizontalAlignment="Left" Margin="265,370,0,0" VerticalAlignment="Top" Height="200" Width="250" Content="🔊 4" FontSize="20" Click="variantButton_Click"/>
        <Button x:Name="continueButton" Content="Проверить" HorizontalAlignment="Center" Margin="0,590,0,0" VerticalAlignment="Top" Width="505" Height="100" FontSize="20" Click="continueButton_Click"/>
        <ProgressBar x:Name="sessionProgressBar" HorizontalAlignment="Center" Height="10" Margin="0,575,0,0" VerticalAlignment="Top" Width="505"/>

    </Grid>
</Page>
