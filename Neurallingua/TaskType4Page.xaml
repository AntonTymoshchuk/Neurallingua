<Page x:Class="Neurallingua.TaskType4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Neurallingua"
      mc:Ignorable="d"
      Title="TaskType4Page" Height="484" Width="405">

    <Grid>
        <TextBlock x:Name="phraseTextBlock" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="100" Width="386" FontSize="16" TextAlignment="Center"/>
        <Button x:Name="variant1Button" HorizontalAlignment="Left" Margin="10,115,0,0" VerticalAlignment="Top" Height="150" Width="190" Content="🔊 1" FontSize="16" Click="variantButton_Click"/>
        <Button x:Name="variant2Button" HorizontalAlignment="Left" Margin="205,115,0,0" VerticalAlignment="Top" Width="190" Height="150" Content="🔊 2" FontSize="16" Click="variantButton_Click"/>
        <Button x:Name="variant3Button" HorizontalAlignment="Left" Margin="10,270,0,0" VerticalAlignment="Top" Height="148" Width="190" Content="🔊 3" FontSize="16" Click="variantButton_Click"/>
        <Button x:Name="variant4Button" HorizontalAlignment="Left" Margin="205,270,0,0" VerticalAlignment="Top" Height="148" Width="190" Content="🔊 4" FontSize="16" Click="variantButton_Click"/>
        <Button x:Name="continueButton" Content="Проверить" HorizontalAlignment="Center" Margin="0,424,0,0" VerticalAlignment="Top" Width="386" Height="50" FontSize="16" Click="continueButton_Click"/>

    </Grid>
</Page>
